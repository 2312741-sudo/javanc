<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.edu.dlu.dhopm.ui.controller.MainController"
            prefHeight="800.0" prefWidth="1200.0" styleClass="root-pane">

    <!-- TOP: HEADER BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="header-bar">
            <padding>
                <Insets top="14.0" right="20.0" bottom="14.0" left="20.0"/>
            </padding>
            <VBox spacing="2.0">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="⚡ DHOPM Stream Visualizer" styleClass="app-title"/>
                    <Label text="v1.0.0" styleClass="badge-version"/>
                </HBox>
                <Label text="Khai phá mẫu có độ chiếm dụng cao trên luồng dữ liệu thời gian thực (EAAI 2026)" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="10.0" styleClass="header-meta">
                <Label text="Môn: Lập Trình Java Nâng Cao" styleClass="meta-tag"/>
                <Label text="ĐH Đà Lạt" styleClass="meta-tag"/>
            </HBox>
        </HBox>
    </top>

    <!-- LEFT: SIDEBAR CONTROLS -->
    <left>
        <ScrollPane fitToWidth="true" styleClass="sidebar-scroll">
            <VBox spacing="16.0" prefWidth="320.0" styleClass="sidebar">
                <padding>
                    <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                </padding>

                <!-- PANEL 0: ENGINE SELECTOR -->
                <VBox spacing="10.0" styleClass="panel-card">
                    <Label text="🔌 CHỌN ENGINE" styleClass="panel-title"/>
                    <ComboBox fx:id="cbEngineMode" maxWidth="Infinity" prefHeight="34.0"/>
                    <Label fx:id="lblEngineName" text="Tâm-Simulation" styleClass="help-text" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="Pha cuối:" styleClass="stat-label"/>
                        <Label fx:id="lblLastPhase" text="—" styleClass="stat-number" style="-fx-font-size: 11px;"/>
                    </HBox>
                    <ProgressBar fx:id="progressMining" maxWidth="Infinity" progress="0.0" prefHeight="8.0"/>
                    <HBox alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 2 0 0 0;">
                        <Label text="Ước tính (ETA):" styleClass="stat-label" style="-fx-font-size: 11px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblMiningEta" text="Chờ lệnh" styleClass="stat-number" style="-fx-font-size: 11px; -fx-text-fill: #ea580c; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- PANEL 0.5: TSON FIMI DATASETS & TOOLS -->
                <VBox spacing="10.0" styleClass="panel-card" style="-fx-border-color: #cbd5e1; -fx-border-width: 1.5;">
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label text="📦 TẬP DỮ LIỆU FIMI (TSON)" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="V1 CLI" styleClass="status-badge" style="-fx-background-color: #ede9fe; -fx-text-fill: #7c3aed;"/>
                    </HBox>

                    <!-- ComboBox Dataset -->
                    <VBox spacing="4.0">
                        <Label text="Chọn Dataset chuẩn:" styleClass="field-label"/>
                        <ComboBox fx:id="cbTsonDataset" maxWidth="Infinity" prefHeight="30.0"/>
                    </VBox>

                    <!-- Limit & Browse -->
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Giới hạn tx (tự gõ số):" styleClass="field-label"/>
                            <ComboBox fx:id="cbTsonLimit" editable="true" promptText="VD: 2500 (0=hết)" maxWidth="Infinity" prefHeight="30.0"/>
                        </VBox>
                        <VBox spacing="4.0">
                            <Label text="File ngoài:" styleClass="field-label"/>
                            <Button fx:id="btnBrowseDataset" text="📂 Chọn..." prefHeight="30.0" styleClass="btn-outline"/>
                        </VBox>
                    </HBox>

                    <Separator/>

                    <!-- Actions directly matching Tson's README commands -->
                    <Label text="Chạy lệnh (không cần terminal):" styleClass="field-label" style="-fx-font-weight: bold;"/>
                    
                    <HBox spacing="6.0">
                        <Button fx:id="btnTsonMine" text="🚀 Khai Phá Dataset (Mine)" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="34.0" styleClass="btn-primary" style="-fx-background-color: #2563eb; -fx-font-weight: bold;"/>
                        <Button fx:id="btnTsonStop" text="🛑 Dừng" disable="true" prefHeight="34.0" prefWidth="85.0" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"/>
                    </HBox>
                    
                    <HBox spacing="6.0">
                        <Button fx:id="btnTsonInspect" text="📊 Thống kê (Inspect)" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-emerald"/>
                        <Button fx:id="btnTsonDetail" text="🔬 Top DO (Detail)" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-indigo"/>
                    </HBox>
                    
                    <Button fx:id="btnTsonGolden" text="🏆 Chạy TestKit Vàng (Golden TC1-8)" maxWidth="Infinity" styleClass="btn-purple"/>
                </VBox>

                <!-- PANEL 1: THAM SO THUAT TOAN -->
                <VBox spacing="12.0" styleClass="panel-card">
                    <Label text="⚙️ THAM SỐ THUẬT TOÁN" styleClass="panel-title"/>

                    <!-- Slider f -->
                    <VBox spacing="4.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Hệ số suy giảm (f):" styleClass="field-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblFValue" text="0.90" styleClass="field-value-highlight"/>
                        </HBox>
                        <Slider fx:id="sliderF" min="0.5" max="1.0" value="0.9" blockIncrement="0.05"
                                showTickLabels="true" showTickMarks="true" majorTickUnit="0.1" minorTickCount="1"/>
                        <Label text="f nhỏ = ưu tiên dữ liệu mới; f=1.0 = không suy giảm" styleClass="help-text"/>
                    </VBox>

                    <!-- Slider minSup ratio & Keyboard input -->
                    <VBox spacing="4.0">
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Label text="Tỷ lệ ngưỡng tối thiểu (∂):" styleClass="field-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="txtMinSupRatio" prefWidth="65.0" prefHeight="26.0" text="15%"
                                       promptText="15%" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-color: #eff6ff; -fx-border-color: #93c5fd; -fx-border-radius: 4; -fx-background-radius: 4;"/>
                            <Label fx:id="lblMinSupValue" visible="false" managed="false"/>
                        </HBox>
                        <Slider fx:id="sliderMinSup" min="0.001" max="0.50" value="0.15" blockIncrement="0.05"
                                showTickLabels="true" showTickMarks="true" majorTickUnit="0.10" minorTickCount="1"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="minSup tuyệt đối:" styleClass="field-label-sub"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblAbsoluteMinSup" text="1.20" styleClass="field-value-sub"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- PANEL 2: DIEU KHIEN STREAM -->
                <VBox spacing="12.0" styleClass="panel-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📡 LUỒNG DỮ LIỆU (STREAM)" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblStreamStatus" text="Sẵn sàng" styleClass="status-badge"/>
                    </HBox>

                    <HBox spacing="8.0">
                        <Button fx:id="btnStartStream" text="▶ Bắt đầu" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary"/>
                        <Button fx:id="btnPauseStream" text="⏸ Tạm dừng" disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-warning"/>
                    </HBox>

                    <Button fx:id="btnStepStream" text="➕ Bơm từng giao dịch (Step Next)" maxWidth="Infinity" styleClass="btn-secondary"/>
                    <Button fx:id="btnReset" text="🔄 Khôi phục 8 giao dịch gốc" maxWidth="Infinity" styleClass="btn-outline"/>
                </VBox>

                <!-- PANEL 3: THONG KE THOI GIAN THUC -->
                <VBox spacing="10.0" styleClass="panel-card">
                    <Label text="📊 THỐNG KÊ THỰC THI" styleClass="panel-title"/>

                    <HBox styleClass="stat-row">
                        <Label text="TID mới nhất (TL):" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTL" text="T8" styleClass="stat-number"/>
                    </HBox>

                    <HBox styleClass="stat-row">
                        <Label text="Tổng số giao dịch:" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTransCount" text="8" styleClass="stat-number"/>
                    </HBox>

                    <HBox styleClass="stat-row">
                        <Label text="Số mẫu DHOP tìm được:" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDhopCount" text="2 mẫu" styleClass="stat-number-green"/>
                    </HBox>

                    <HBox styleClass="stat-row">
                        <Label text="Tổng mẫu duyệt qua:" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblVisitedCount" text="32 mẫu" styleClass="stat-number"/>
                    </HBox>

                    <HBox styleClass="stat-row">
                        <Label text="Bị cắt tỉa bởi DUBO:" styleClass="stat-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblPrunedCount" text="19 mẫu (59.4%)" styleClass="stat-number-red"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- CENTER: TABS -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="main-tab-pane">
            <!-- TAB 1: DHO-LIST NODES -->
            <Tab text="🗂️ Global DHO-List Nodes">
                <VBox spacing="12.0">
                    <padding>
                        <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="order-banner">
                        <Label text="Thứ tự xử lý (Support tăng dần):" styleClass="order-title"/>
                        <Label fx:id="lblSortOrder" text="G ≺ B ≺ A ≺ C ≺ D ≺ E ≺ F" styleClass="order-content"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="content-scroll">
                        <FlowPane fx:id="dhoNodesPane" hgap="12.0" vgap="12.0" styleClass="nodes-flow-pane">
                            <padding>
                                <Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/>
                            </padding>
                        </FlowPane>
                    </ScrollPane>
                </VBox>
            </Tab>

            <!-- TAB 2: MINING RESULTS TABLE -->
            <Tab text="📋 Chi Tiết Mẫu &amp; Khai Phá (DFS Tree)">
                <VBox spacing="12.0">
                    <padding>
                        <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                    </padding>

                    <TableView fx:id="tableResults" VBox.vgrow="ALWAYS" styleClass="results-table">
                        <columns>
                            <TableColumn fx:id="colPattern" text="Mẫu X" prefWidth="100.0"/>
                            <TableColumn fx:id="colSupport" text="Support (tx / %)" prefWidth="120.0" style="-fx-alignment: CENTER-RIGHT;"/>
                            <TableColumn fx:id="colDO" text="DO(X)" prefWidth="110.0"/>
                            <TableColumn fx:id="colDUBO" text="DUBO(X)" prefWidth="110.0"/>
                            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120.0"/>
                            <TableColumn fx:id="colTransactions" text="Các giao dịch chứa mẫu" prefWidth="250.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 3: TRỰC QUAN HOÁ & LỊCH SỬ MINING (QUÉT THEO TỪNG MINSUP) -->
            <Tab text="📈 Trực Quan Hoá &amp; Lịch Sử">
                <VBox spacing="8.0">
                    <padding>
                        <Insets top="8.0" right="14.0" bottom="8.0" left="14.0"/>
                    </padding>

                    <!-- THANH ĐIỀU KHIỂN QUÉT DẢI MINSUP (BENCHMARK SWEEP RUNNER) -->
                    <VBox spacing="6.0" style="-fx-padding: 8 12 8 12; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="🔬 Quét Thực Nghiệm Theo minSup (Chuẩn Figures Bài Báo EAAI 2026):" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Preset nhanh:" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                            <Button fx:id="btnPresetPaper" text="📄 Bài Báo (5%→30%)" styleClass="btn-outline" style="-fx-font-size: 10px; -fx-padding: 2 6 2 6;"/>
                            <Button fx:id="btnPresetFine" text="🔬 Mịn (2%→20%)" styleClass="btn-outline" style="-fx-font-size: 10px; -fx-padding: 2 6 2 6;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="Từ ∂:" style="-fx-font-size: 11px; -fx-text-fill: #334155;"/>
                            <TextField fx:id="txtSweepStart" text="5%" prefWidth="55.0" style="-fx-font-size: 11px; -fx-alignment: CENTER;"/>
                            <Label text="Đến ∂:" style="-fx-font-size: 11px; -fx-text-fill: #334155;"/>
                            <TextField fx:id="txtSweepEnd" text="30%" prefWidth="55.0" style="-fx-font-size: 11px; -fx-alignment: CENTER;"/>
                            <Label text="Bước:" style="-fx-font-size: 11px; -fx-text-fill: #334155;"/>
                            <TextField fx:id="txtSweepStep" text="5%" prefWidth="55.0" style="-fx-font-size: 11px; -fx-alignment: CENTER;"/>
                            <Button fx:id="btnRunSweep" text="🚀 Chạy Quét Từng minSup" styleClass="btn-primary" style="-fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Button fx:id="btnCancelSweep" text="⏹ Dừng" disable="true" styleClass="btn-danger" style="-fx-font-size: 11px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ProgressBar fx:id="progressSweep" prefWidth="130.0" progress="0.0"/>
                            <Label fx:id="lblSweepStatus" text="Sẵn sàng quét" style="-fx-font-size: 11px; -fx-text-fill: #059669; -fx-font-weight: bold;"/>
                            <Label fx:id="lblSweepEta" text="" style="-fx-font-size: 11px; -fx-text-fill: #ea580c; -fx-font-weight: bold;"/>
                        </HBox>
                    </VBox>

                    <!-- VIEW SWITCHER CHO TAB 3 -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 4 10 4 10; -fx-background-color: #ffffff; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                        <Label text="📊 Biểu Đồ Bài Báo:" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #1e293b;"/>
                        <Button fx:id="btnChartFig11" text="⏱️ Runtime vs minSup (Fig 11)" styleClass="btn-outline" style="-fx-font-size: 11px;"/>
                        <Button fx:id="btnChartFig6" text="🎯 DHOPs &amp; Cắt Tỉa vs minSup (Fig 6)" styleClass="btn-outline" style="-fx-font-size: 11px;"/>
                        <Button fx:id="btnChartFig13" text="💾 Heap RAM vs minSup (Fig 13)" styleClass="btn-outline" style="-fx-font-size: 11px;"/>
                        <Button fx:id="btnChartModeDO" text="📈 Item DO vs minSup (Fig 2)" styleClass="btn-outline" style="-fx-font-size: 11px;"/>
                        <Button fx:id="btnChartModeHistory" text="🕒 Lịch Sử Tất Cả Lần Chạy" styleClass="btn-outline" style="-fx-font-size: 11px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblSweepCountBadge" text="6 mốc minSup đã quét" styleClass="badge-version"/>
                    </HBox>

                    <!-- KHU VỰC BIỂU ĐỒ (STACKPANE) -->
                    <StackPane VBox.vgrow="ALWAYS" prefHeight="290.0">
                        <!-- Biểu đồ Fig 11: Runtime vs minSup (∂) -->
                        <LineChart fx:id="lineChartFig11" styleClass="trend-chart" title="Figure 11 (Bài Báo Gốc): Thời Gian Thực Thi Theo Từng Ngưỡng minSup (∂)">
                            <xAxis><CategoryAxis label="Ngưỡng Hỗ Trợ Tối Thiểu (minSup ratio ∂)"/></xAxis>
                            <yAxis><NumberAxis label="Thời gian thực thi (ms)"/></yAxis>
                        </LineChart>

                        <!-- Biểu đồ Fig 6: DHOPs & Cắt Tỉa DUBO vs minSup (∂) -->
                        <LineChart fx:id="lineChartFig6" styleClass="trend-chart" title="Figure 6 &amp; Hiệu Quả Cắt Tỉa DUBO: Số Lượng Mẫu &amp; Ứng Viên Theo Từng minSup (∂)" visible="false">
                            <xAxis><CategoryAxis label="Ngưỡng Hỗ Trợ Tối Thiểu (minSup ratio ∂)"/></xAxis>
                            <yAxis><NumberAxis label="Số lượng mẫu / nhánh DFS"/></yAxis>
                        </LineChart>

                        <!-- Biểu đồ Fig 13: Memory Heap vs minSup (∂) -->
                        <LineChart fx:id="lineChartFig13" styleClass="trend-chart" title="Figure 13 (Bài Báo Gốc): Dung Lượng Bộ Nhớ Peak Heap RAM Theo Từng minSup (∂)" visible="false">
                            <xAxis><CategoryAxis label="Ngưỡng Hỗ Trợ Tối Thiểu (minSup ratio ∂)"/></xAxis>
                            <yAxis><NumberAxis label="Bộ nhớ JVM Heap (MB)"/></yAxis>
                        </LineChart>

                        <!-- Biểu đồ Fig 2: LineChart DO vs minSup -->
                        <LineChart fx:id="lineChartDO" styleClass="trend-chart" title="Figure 2: So Sánh Damped Occupancy (DO) Của Các Mục Với Ngưỡng minSup" visible="false">
                            <xAxis><CategoryAxis label="Mục / Mẫu theo thứ tự Support"/></xAxis>
                            <yAxis><NumberAxis label="Giá trị DO"/></yAxis>
                        </LineChart>

                        <!-- Biểu đồ Lịch sử các lần mining -->
                        <LineChart fx:id="lineChartHistory" styleClass="trend-chart" title="Biểu Đồ Xu Hướng Qua Các Lần Khai Phá (DHOPs, Cắt Tỉa, Runtime)" visible="false">
                            <xAxis><CategoryAxis label="Lượt chạy (Mining Runs)"/></xAxis>
                            <yAxis><NumberAxis label="Số lượng mẫu / ms"/></yAxis>
                        </LineChart>

                        <!-- Biểu đồ BarChart Phân bố kết quả -->
                        <BarChart fx:id="barChartDistribution" styleClass="trend-chart" title="Tỷ Lệ Mẫu Đạt DHOP vs Bị Cắt Tỉa Bởi DUBO Qua Các Lần Chạy" visible="false">
                            <xAxis><CategoryAxis label="Lượt chạy"/></xAxis>
                            <yAxis><NumberAxis label="Số lượng mẫu"/></yAxis>
                        </BarChart>
                    </StackPane>

                    <!-- KHU VỰC BẢNG DỮ LIỆU CHI TIẾT (STACKED / SWITCHABLE) -->
                    <VBox spacing="4.0" prefHeight="200.0">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="📋 DỮ LIỆU ĐO ĐẠC CHI TIẾT:" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #334155;"/>
                            <HBox spacing="4.0">
                                <Button fx:id="btnViewSweepTable" text="🔬 Bảng Kết Quả Quét Từng minSup" styleClass="btn-outline" style="-fx-font-size: 10px;"/>
                                <Button fx:id="btnViewHistoryTable" text="💾 Lịch Sử Các Lần Khai Phá (Memento)" styleClass="btn-outline" style="-fx-font-size: 10px;"/>
                            </HBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnClearHistory" text="🗑️ Xóa Lịch Sử" style="-fx-font-size: 10px;" styleClass="btn-outline"/>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">
                            <!-- BẢNG 1: KẾT QUẢ QUÉT TỪNG MINSUP -->
                            <TableView fx:id="tblSweepResults" styleClass="results-table">
                                <columns>
                                    <TableColumn fx:id="colSwpPartial" text="Mốc ∂ (%)" prefWidth="85.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="colSwpMinSup" text="minSup" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colSwpDhops" text="Số DHOPs" prefWidth="95.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                                    <TableColumn fx:id="colSwpPruned" text="DUBO Cắt Tỉa" prefWidth="105.0" style="-fx-alignment: CENTER-RIGHT; -fx-text-fill: #dc2626;"/>
                                    <TableColumn fx:id="colSwpPrunedRatio" text="Tỷ lệ cắt tỉa" prefWidth="95.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                                    <TableColumn fx:id="colSwpCandidates" text="Tổng Ứng Viên" prefWidth="105.0" style="-fx-alignment: CENTER-RIGHT;"/>
                                    <TableColumn fx:id="colSwpRuntime" text="Runtime (ms)" prefWidth="105.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                                    <TableColumn fx:id="colSwpHeap" text="Peak Heap RAM" prefWidth="110.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>

                            <!-- BẢNG 2: LỊCH SỬ CÁC LẦN MINING (MEMENTO) -->
                            <TableView fx:id="tblMiningHistory" styleClass="results-table" visible="false">
                                <columns>
                                    <TableColumn fx:id="colHistRunId" text="Lần #" prefWidth="55.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colHistTime" text="Thời gian" prefWidth="85.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colHistEngine" text="Engine" prefWidth="120.0"/>
                                    <TableColumn fx:id="colHistDataset" text="Dataset" prefWidth="130.0"/>
                                    <TableColumn fx:id="colHistF" text="f" prefWidth="55.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colHistPartial" text="∂ (%)" prefWidth="65.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colHistMinSup" text="minSup" prefWidth="75.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colHistTx" text="Giao dịch" prefWidth="85.0" style="-fx-alignment: CENTER-RIGHT;"/>
                                    <TableColumn fx:id="colHistDhops" text="Số DHOPs" prefWidth="85.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                                    <TableColumn fx:id="colHistPruned" text="Cắt tỉa" prefWidth="85.0" style="-fx-alignment: CENTER-RIGHT; -fx-text-fill: #dc2626;"/>
                                    <TableColumn fx:id="colHistRuntime" text="Runtime (ms)" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold;"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </StackPane>
                    </VBox>
                </VBox>
            </Tab>

            <!-- TAB 4: KẾT QUẢ & BENCHMARK TSON (UI THAY VÌ TERMINAL) -->
            <Tab text="📊 Kết Quả &amp; Benchmark Tson">
                <VBox spacing="14.0">
                    <padding>
                        <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                    </padding>

                    <!-- 4 KPI CARDS -->
                    <HBox spacing="12.0">
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4.0">
                            <Label text="⏱️ TỔNG THỜI GIAN" styleClass="kpi-title"/>
                            <Label fx:id="lblKpiTime" text="— ms" styleClass="kpi-value" style="-fx-text-fill: #2563eb;"/>
                            <Label fx:id="lblKpiPhases" text="Constr: — | Reconst: — | Mine: —" styleClass="help-text"/>
                        </VBox>
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4.0">
                            <Label text="💾 BỘ NHỚ PEAK HEAP" styleClass="kpi-title"/>
                            <Label fx:id="lblKpiHeap" text="— MB" styleClass="kpi-value" style="-fx-text-fill: #059669;"/>
                            <Label text="Đo đạc mức JVM Heap" styleClass="help-text"/>
                        </VBox>
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4.0">
                            <Label text="🎯 SỐ MẪU DHOP" styleClass="kpi-title"/>
                            <Label fx:id="lblKpiPatterns" text="— mẫu" styleClass="kpi-value" style="-fx-text-fill: #7c3aed;"/>
                            <Label fx:id="lblKpiMinSup" text="minSup: —" styleClass="help-text"/>
                        </VBox>
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4.0">
                            <Label text="⚡ TỐC ĐỘ (THROUGHPUT)" styleClass="kpi-title"/>
                            <Label fx:id="lblKpiThroughput" text="— tx/s" styleClass="kpi-value" style="-fx-text-fill: #ea580c;"/>
                            <Label fx:id="lblKpiTrans" text="Tổng giao dịch: —" styleClass="help-text"/>
                        </VBox>
                    </HBox>

                    <!-- VIEW SWITCHER & SUB-HEADER -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8 12 8 12; -fx-background-color: #f1f5f9; -fx-background-radius: 8;">
                        <Label fx:id="lblTsonViewTitle" text="📋 Danh Sách Mẫu Chi Tiết (Tson V1 Engine)" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #0f172a;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTab4EtaStatus" text="" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #ea580c;"/>
                        <HBox spacing="6.0">
                            <Button fx:id="btnViewPatterns" text="📋 Bảng Mẫu DHOPs" styleClass="btn-outline"/>
                            <Button fx:id="btnViewInspect" text="📊 Thống Kê Items" styleClass="btn-outline"/>
                            <Button fx:id="btnViewGolden" text="🏆 Bộ TestKit Vàng" styleClass="btn-outline"/>
                        </HBox>
                    </HBox>

                    <!-- MAIN STACKED CONTENT AREA -->
                    <StackPane VBox.vgrow="ALWAYS">
                        <!-- VIEW 1: BẢNG MẪU DHOPs TSON -->
                        <TableView fx:id="tblTsonPatterns" styleClass="results-table">
                            <columns>
                                <TableColumn fx:id="colTsonIndex" text="STT" prefWidth="55.0" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colTsonPattern" text="Mẫu mục chiếm dụng (Itemset X)" prefWidth="380.0"/>
                                <TableColumn fx:id="colTsonDO" text="Độ đo DO(X)" prefWidth="120.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold;"/>
                                <TableColumn fx:id="colTsonSupport" text="Support (tx / %)" prefWidth="130.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold;"/>
                                <TableColumn fx:id="colTsonLength" text="Độ dài |X|" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colTsonTids" text="Danh sách giao dịch (TIDs)" prefWidth="250.0"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <!-- VIEW 2: BẢNG THỐNG KÊ DATASET (INSPECT) -->
                        <VBox fx:id="boxTsonInspect" spacing="12.0" visible="false">
                            <!-- Card tổng quan thuộc tính dataset -->
                            <HBox spacing="12.0">
                                <VBox spacing="6.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label text="THÔNG TIN TẬP DỮ LIỆU" styleClass="kpi-title"/>
                                    <HBox styleClass="stat-row"><Label text="Tập tin:" styleClass="stat-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblInspectFile" text="—" styleClass="stat-number"/></HBox>
                                    <HBox styleClass="stat-row"><Label text="Tổng số giao dịch:" styleClass="stat-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblInspectTx" text="—" styleClass="stat-number"/></HBox>
                                    <HBox styleClass="stat-row"><Label text="TID mới nhất (TL):" styleClass="stat-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblInspectTL" text="—" styleClass="stat-number"/></HBox>
                                </VBox>
                                <VBox spacing="6.0" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                                    <Label text="ĐẶC TRƯNG MẶT HÀNG" styleClass="kpi-title"/>
                                    <HBox styleClass="stat-row"><Label text="Số mặt hàng khác biệt:" styleClass="stat-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblInspectItems" text="—" styleClass="stat-number"/></HBox>
                                    <HBox styleClass="stat-row"><Label text="Độ dài trung bình:" styleClass="stat-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblInspectAvgLen" text="—" styleClass="stat-number"/></HBox>
                                    <HBox styleClass="stat-row"><Label text="Độ dài lớn nhất:" styleClass="stat-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblInspectMaxLen" text="—" styleClass="stat-number"/></HBox>
                                </VBox>
                            </HBox>

                            <!-- Bảng Top Items -->
                            <TableView fx:id="tblInspectTopItems" VBox.vgrow="ALWAYS" styleClass="results-table">
                                <columns>
                                    <TableColumn fx:id="colInspectRank" text="Hạng" prefWidth="60.0" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colInspectItem" text="Mã mặt hàng (Item ID / Name)" prefWidth="320.0"/>
                                    <TableColumn fx:id="colInspectSupport" text="Tần số xuất hiện (Support)" prefWidth="180.0" style="-fx-alignment: CENTER-RIGHT; -fx-font-weight: bold;"/>
                                    <TableColumn fx:id="colInspectPercentage" text="Tỷ lệ xuất hiện (%)" prefWidth="160.0" style="-fx-alignment: CENTER-RIGHT;"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <!-- VIEW 3: BẢNG MA TRẬN TESTKIT VÀNG (GOLDEN TC1 - TC8) -->
                        <TableView fx:id="tblTsonGolden" styleClass="results-table" visible="false">
                            <columns>
                                <TableColumn fx:id="colGoldenCase" text="Test Case" prefWidth="80.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                                <TableColumn fx:id="colGoldenF" text="Hệ số f" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colGoldenPartial" text="Ngưỡng ∂" prefWidth="90.0" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colGoldenMinSup" text="minSup" prefWidth="90.0" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colGoldenExpected" text="Kỳ vọng (Bài báo gốc)" prefWidth="220.0"/>
                                <TableColumn fx:id="colGoldenActual" text="Thực tế (Engine Tson)" prefWidth="180.0"/>
                                <TableColumn fx:id="colGoldenStatus" text="Trạng thái kiểm định" prefWidth="140.0" style="-fx-alignment: CENTER;"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </StackPane>
                </VBox>
            </Tab>

            <!-- TAB 5: NHẬT KÝ CHI TIẾT TỪNG BƯỚC TÍNH TOÁN -->
            <Tab text="📜 Nhật Ký &amp; Phép Tính">
                <VBox spacing="10.0">
                    <padding>
                        <Insets top="10.0" right="16.0" bottom="10.0" left="16.0"/>
                    </padding>

                    <!-- TOOLBAR CHO TAB 5 -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8 12 8 12; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
                        <Label text="📜 NHẬT KÝ CHI TIẾT PHÉP TÍNH (CALCULATION LOG)" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;"/>
                        <Separator orientation="VERTICAL"/>
                        <TextField fx:id="txtLogFilter" promptText="🔍 Lọc theo Item/Mẫu (VD: AE, F)..." prefWidth="220.0" prefHeight="28.0" style="-fx-font-size: 11px;"/>
                        <ComboBox fx:id="cbLogPhaseFilter" prefWidth="150.0" prefHeight="28.0" promptText="Lọc theo Pha"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnClearLog" text="🗑️ Xóa Log" styleClass="btn-outline" style="-fx-font-size: 11px;"/>
                        <Button fx:id="btnExportLog" text="📋 Sao Chép Log" styleClass="btn-outline" style="-fx-font-size: 11px;"/>
                    </HBox>

                    <!-- SPLIT PANE: BẢNG NHẬT KÝ + CHI TIẾT CÔNG THỨC -->
                    <SplitPane orientation="VERTICAL" dividerPositions="0.68" VBox.vgrow="ALWAYS">
                        <!-- TOP: TABLEVIEW LOGS -->
                        <TableView fx:id="tblCalculationLog" styleClass="results-table">
                            <columns>
                                <TableColumn fx:id="colLogId" text="STT" prefWidth="55.0" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colLogTime" text="Thời gian" prefWidth="95.0" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colLogPhase" text="Pha thuật toán" prefWidth="130.0"/>
                                <TableColumn fx:id="colLogTarget" text="Đối tượng" prefWidth="90.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                                <TableColumn fx:id="colLogFormula" text="Công thức &amp; Khai triển số học chi tiết" prefWidth="420.0"/>
                                <TableColumn fx:id="colLogComparison" text="So sánh minSup" prefWidth="160.0" style="-fx-alignment: CENTER;"/>
                                <TableColumn fx:id="colLogDecision" text="Quyết định" prefWidth="120.0" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <!-- BOTTOM: FORMULA INSPECTOR DETAIL -->
                        <VBox spacing="4.0" style="-fx-padding: 6 10 6 10; -fx-background-color: #f1f5f9;">
                            <Label text="🔍 Chi tiết công thức toán học và diễn giải bước tính đã chọn:" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #1e293b;"/>
                            <TextArea fx:id="txtLogDetail" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                                      prefHeight="85.0" style="-fx-font-family: 'Menlo', 'Monaco', 'Courier New', monospace; -fx-font-size: 11px; -fx-text-fill: #0f172a;"/>
                        </VBox>
                    </SplitPane>
                </VBox>
            </Tab>
        </TabPane>
    </center>

</BorderPane>
